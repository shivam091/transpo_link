= title(t(".title"))
.card.card-primary.border.border-primary
  .card-body
    .table-responsive
      %table.table.table-striped.table-borderless
        %thead.border
          %tr.table-active
            %th{width: "3%", scope: "col"}#
            %th{scope: "col"}= Role.human_attribute_name(:name)
            %th{scope: "col"}= Role.human_attribute_name(:is_active)
            %th{width: "3%", scope: "col"}= t("shared.actions")
        %tbody.border
          - if @roles&.each.with_index(1) do |role, index|
            = render_if_exists("roles/role", locals: {role:, index:})
          - end.empty?
            = render_if_exists("shared/no_records", locals: {resource: Role})
