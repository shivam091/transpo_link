= title(t(".title"))
.card.card-primary.border.border-primary
  .card-body
    .table-responsive
      %table.table.table-striped.table-borderless
        %thead.border
          %tr.table-active
            %th{width: "3%", scope: "col"}#
            - Role::LISTING_ATTRIBUTES.each do |attribute|
              %th{scope: "col"}
                = Role.human_attribute_name(attribute)
            %th{width: "3%", scope: "col"}
              = t("shared.actions")
        %tbody.border
          - if @roles&.each.with_index(1) do |role, index|
            = safe_render.partial("roles/role", role:, index:)
          - end.empty?
            = safe_render.partial("shared/no_records", resource: Role)
