.table-row
  .table-cell.cell-narrow
    = index
  .table-cell
    = conditional_link_to authorized_for?(:roles, :view), role_path(role) do
      = role.name
  .table-cell
    = humanize_boolean(role.is_active)
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      - if authorized_for?(:roles, :view)
        %li
          = link_to role_path(role), class: "dropdown-item" do
            = sprite_icon("arrow-right")
            = button_text(:view_details)
      - if authorized_for?(:roles, :update)
        %li
          = link_to edit_role_path(role), class: "dropdown-item" do
            = sprite_icon("pencil")
            = button_text(:edit)
