= title(@role.name)
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header.d-flex.align-items-center.justify-content-between
        .d-block
          .widget-title
            = h(@role.name)
          .widget-help
            %span.middle-dot-divider
              = Role.human_attribute_name(:created_at)
              = h(time_ago_with_tooltip(@role.created_at))
            %span.middle-dot-divider
              = Role.human_attribute_name(:updated_at)
              = h(time_ago_with_tooltip(@role.updated_at))
        = link_to edit_role_path(@role), class: "btn btn-secondary" do
          = external_svg_tag("svgs/pencil.svg")
          = button_text(:edit)
      .widget-body
        .widget-row
          .widget-row-content
            .widget-row-title= Role.human_attribute_name(:name)
            .widget-row-body= h(@role.name)
        .widget-row
          .widget-row-content
            .widget-row-title= Role.human_attribute_name(:is_active)
            .widget-row-body= h(humanize_boolean(@role.is_active))
        
