= pretty_form_with model: @role do |form|
  = form_errors(@role)
  .row
    .col-sm-12.col-md-6.col-lg-4.mb-3
      = form.label :name, class: "form-label"
      = form.text_field :name, static: true
    .col-sm-12.col-md-6.col-lg-4.mb-3
      = form.label :is_active, class: "form-check-label mb-2"
      .form-check
        = form.check_box :is_active, autofocus: true
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = external_svg_tag("svgs/floppy.svg")
      = button_text(:update)
    = link_to roles_path, class: "btn btn-secondary" do
      = external_svg_tag("svgs/cancel.svg")
      = button_text(:cancel)
