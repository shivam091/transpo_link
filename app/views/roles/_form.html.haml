= pretty_form_with model: @role, class: "row g-3" do |form|
  = form_errors(@role)
  .subheader
    = t(".basic_details")
  = safe_render.partial("roles/basic_details_fields", form:)
  .subheader
    = t(".permissions")
  = safe_render.partial("roles/role_permissions/form_fields", form:)
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = sprite_icon("floppy")
      = button_text(:update)
    = link_to roles_path, class: "btn btn-secondary" do
      = sprite_icon("times")
      = button_text(:cancel)
