= pretty_form_with model: @role, class: "row g-3" do |form|
  = form_errors(@role)
  .col-sm-12.col-md-6.col-lg-4
    = form.label :name, class: "form-label"
    = form.text_field :name, static: true
  .col-sm-12.col-md-6.col-lg-4
    = form.label :is_active, class: "form-check-label mb-2"
    .form-check
      = form.check_box :is_active, autofocus: true
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = sprite_icon("floppy")
      = button_text(:update)
    = link_to roles_path, class: "btn btn-secondary" do
      = sprite_icon("times")
      = button_text(:cancel)
