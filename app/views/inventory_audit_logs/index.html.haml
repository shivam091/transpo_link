.table-wrapper
  .table-container
    .table-header
      .table-cell.cell-narrow #
      - Inventory::AuditLog::LISTING_ATTRIBUTES.each do |attribute|
        .table-cell
          = Inventory::AuditLog.human_attribute_name(attribute)
    .table-body
      - if @inventory_audit_logs&.each.with_index(1) do |inventory_audit_log, index|
        = safe_render.partial("inventory_audit_logs/inventory_audit_log", inventory_audit_log:, index:)
      - end.empty?
        = safe_render.partial("shared/no_records", resource: Inventory::AuditLog)
