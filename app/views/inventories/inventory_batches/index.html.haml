.table-wrapper
  .table-container
    .table-header
      .table-cell.cell-narrow #
      - InventoryBatch::LISTING_ATTRIBUTES.each do |attribute|
        .table-cell
          = InventoryBatch.human_attribute_name(attribute)
      .table-cell.cell-narrow
        = t("shared.actions")
    .table-body
      - if @inventory_batches&.each.with_index(1) do |inventory_batch, index|
        = safe_render.partial("inventories/inventory_batches/inventory_batch", inventory_batch:, index:)
      - end.empty?
        = safe_render.partial("shared/no_records", resource: InventoryBatch)
