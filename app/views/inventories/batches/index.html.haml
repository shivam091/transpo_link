.table-wrapper
  .table-container
    .table-header
      .table-cell.cell-narrow #
      - Inventory::Batch::LISTING_ATTRIBUTES.each do |attribute|
        .table-cell
          = Inventory::Batch.human_attribute_name(attribute)
      .table-cell.cell-narrow
        = t("shared.actions")
    .table-body
      - if @inventory.batches&.each.with_index(1) do |batch, index|
        = safe_render.partial("inventories/batches/batch", batch:, index:)
      - end.empty?
        = safe_render.partial("shared/no_records", resource: Inventory::Batch)
