= pretty_form_with model: @inventory, class: "row g-3" do |form|
  - if form.object.persisted?
    .col-sm-12.col-md-6.col-lg-4
      = form.label :reference_code, class: "form-label"
      = form.text_field :reference_code, static: true
  .col-sm-12.col-md-6.col-lg-4
    = form.label :product_id, class: "form-label required"
    = form.select :product_id, options_for_select(Product.select_options, form.object.product_id),
      {include_blank: t(".select_product")}, {autofocus: true}
  .col-sm-12.col-md-6.col-lg-4
    = form.label :warehouse_id, class: "form-label required"
    = form.select :warehouse_id, options_for_select(Warehouse.select_options, form.object.warehouse_id),
      {include_blank: t(".select_warehouse")}, {}
  .col-sm-12.col-md-6.col-lg-4
    = form.label :tracking_method, class: "form-label required"
    = form.select :tracking_method, options_for_select(enum_options_for_select(Inventory, :tracking_methods), form.object.tracking_method),
      {include_blank: t(".select_tracking_method")}, {}
  .col-sm-12.col-md-6.col-lg-4
    = form.label :unit_id, class: "form-label required"
    = form.measurement_unit_select :unit_id, {include_blank: t(".select_inventory_unit")}, {}
  .col-sm-12.col-md-6.col-lg-4
    = form.label :currency, class: "form-label required"
    = form.select :currency, options_for_select(TranspoLink::Currency.select_options, form.object.currency),
      {include_blank: t(".select_currency")}
  .col-sm-12.col-md-6.col-lg-4
    = form.label :low_stock_threshold, class: "form-label required"
    = form.number_field :low_stock_threshold, step: 0.01
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = sprite_icon("floppy")
      = form.object.new_record? ? button_text(:create) : button_text(:update)
    = link_to inventories_path, class: "btn btn-secondary" do
      = sprite_icon("times")
      = button_text(:cancel)
