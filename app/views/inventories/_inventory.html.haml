- product, warehouse = inventory.key_associations
.table-row
  .table-cell.cell-narrow
    = @pagination_metadata.offset + index
  .table-cell
    = link_to inventory.reference_code, inventory_path(inventory)
  .table-cell
    = link_to product.name, product_path(product), target: :_blank
  .table-cell
    = link_to warehouse.name, warehouse_path(warehouse), target: :_blank
  .table-cell
    = enum_l(inventory, :tracking_method)
  .table-cell
    = number_to_measurement_unit(inventory.low_stock_threshold, inventory.inventory_unit)
  .table-cell
    = number_to_currency(inventory.average_cost_price, unit: inventory.currency.symbol)
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = external_svg_tag("svgs/ellipsis-vertical.svg")
    %ul.dropdown-menu
      %li
        = link_to inventory_path(inventory), class: "dropdown-item" do
          = external_svg_tag("svgs/arrow-right.svg")
          = button_text(:view_details)
      %li
        = link_to edit_inventory_path(inventory), class: "dropdown-item" do
          = external_svg_tag("svgs/pencil.svg")
          = button_text(:edit)
