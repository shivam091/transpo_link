- product, warehouse = inventory.key_associations
.table-row
  .table-cell.cell-narrow
    = @pagination_metadata.offset + index
    - if inventory.low_stock?
      .low-stock-notification
        = sprite_icon("exclamation-triangle")
  .table-cell
    = conditional_link_to authorized_for?(:inventories, :view), inventory_path(inventory) do
      = inventory.reference_code
  .table-cell
    = authorized_for?(:products, :view) ? link_to_product(product, target: :_blank) : product.name
  .table-cell
    = authorized_for?(:warehouses, :view) ? link_to_warehouse(warehouse, target: :_blank) : warehouse.name
  .table-cell
    = safe_render.partial("shared/badge", color: TranspoLink::ColorMapper.new(:tracking_method).for(inventory.tracking_method)) do
      = enum_l(inventory, :tracking_method)
  .table-cell
    = number_to_measurement_unit(inventory.low_stock_threshold, inventory.unit_symbol)
  .table-cell
    = number_to_currency(inventory.average_cost_price, unit: inventory.currency.symbol)
  .table-cell.cell-narrow
    - if authorized_for?(:inventory_batches, :view_all)
      = link_to inventory_inventory_batches_path(inventory),
        data: {turbo_frame: dom_id(inventory, :batches), action: "click->lazy-turbo-frame#toggle"} do
        = sprite_icon("fold-down", data: {lazy_turbo_frame_target: "icon"})
        = sprite_icon("fold-up", class: "d-none", data: {lazy_turbo_frame_target: "icon"})
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      %li
        = link_to new_inventory_stock_adjustment_path(inventory), class: "dropdown-item",
          data: {turbo_frame: :remote_modal} do
          = sprite_icon("adjust")
          = button_text(:adjust_stock)
      %li.dropdown-divider
      - if authorized_for?(:inventories, :view)
        %li
          = link_to inventory_path(inventory), class: "dropdown-item" do
            = sprite_icon("arrow-right")
            = button_text(:view_details)
      - if authorized_for?(:inventories, :update)
        %li
          = link_to edit_inventory_path(inventory), class: "dropdown-item" do
            = sprite_icon("pencil")
            = button_text(:edit)
- if authorized_for?(:inventory_batches, :view_all)
  = turbo_frame_tag dom_id(inventory, :batches), class: "d-none"
