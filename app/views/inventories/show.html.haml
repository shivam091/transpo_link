= title(@inventory.reference_code)
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header.d-flex.align-items-center.justify-content-between
        .d-block
          .widget-title
            = @inventory.reference_code
          .widget-help
            %span.middle-dot-divider
              = Inventory.human_attribute_name(:created_at)
              = time_ago_with_tooltip(@inventory.created_at)
            %span.middle-dot-divider
              = Inventory.human_attribute_name(:updated_at)
              = time_ago_with_tooltip(@inventory.updated_at)
        - if authorized_for?(:inventories, :update)
          = link_to edit_inventory_path(@inventory), class: "btn btn-secondary" do
            = sprite_icon("pencil")
            = button_text(:edit)
    .widget
      .widget-header
        .widget-title
          = t(".basic_details")
      .widget-body
        = safe_render.partial("inventories/show")
    - with_permission(:inventory_batches, :view_all) do
      .widget
        .widget-header
          .widget-title
            = t(".batches")
        .widget-body
          = safe_render.template("inventories/inventory_batches/index")
    - with_permission(:inventories, :view_movements) do
      .widget
        .widget-header
          .widget-title
            = t(".movements")
        .widget-body
          = safe_render.template("inventory_movements/index")
    - with_permission(:inventories, :view_logs) do
      .widget
        .widget-header
          .widget-title
            = t(".audit_logs")
        .widget-body
          = safe_render.template("inventory_audit_logs/index")
  .card-footer
    = safe_render.partial("shared/navigable_links", resource: @inventory)
