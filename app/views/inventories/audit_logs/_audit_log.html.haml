- user = audit_log.user
.table-row
  .table-cell.cell-narrow
    = index
  .table-cell
    = link_to user.full_name, user_path(user), target: :_blank
  .table-cell
    = enum_l(audit_log, :type)
  .table-cell
    = number_to_measurement_unit(audit_log.previous_quantity, @inventory.unit_symbol)
  .table-cell
    = number_to_measurement_unit(audit_log.new_quantity, @inventory.unit_symbol)
