.table-row
  .table-cell.cell-narrow
    = index
  .table-cell
    = prettify_datetime(movement.movement_date)
  .table-cell
    = enum_l(movement, :type)
  .table-cell
    = number_to_measurement_unit(movement.quantity, movement.unit_symbol)
  .table-cell
    = number_to_currency(movement.unit_cost, unit: @inventory.currency.symbol)
  .table-cell
    = number_to_currency(movement.total_cost, unit: @inventory.currency.symbol)
