= form_with model: current_user, url: locale_path do |form|
  = form.fields_for :user_preference, include_id: false do |user_preference_form|
    %p.mb-2= t(".preferred_locale_form_info")
    .col-12.mb-2
      = user_preference_form.select :preferred_locale, options_for_select(TranspoLink::I18n.options_for_languages, form.object.preferred_locale),
        {include_blank: t(".select_preferred_language")}, {class: "form-select"}
  .modal-actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = external_svg_tag("svgs/floppy.svg")
      = button_text(:update)
    = button_tag type: :button, class: "btn btn-secondary", data: {action: "click->remote-modal#hide"} do
      = external_svg_tag("svgs/cancel.svg")
      = button_text(:cancel)
