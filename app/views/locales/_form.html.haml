= pretty_form_with model: current_user, url: locale_path, class: "row g-2" do |form|
  = form.fields_for :preference, include_id: false do |preference_form|
    %p
      = t(".preferred_locale_form_info")
    .col-12
      = preference_form.select :preferred_locale, options_for_select(TranspoLink::I18n.select_options, form.object.preferred_locale),
        {include_blank: t(".select_preferred_language")}
  .modal-actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = sprite_icon("floppy")
      = button_text(:update)
    = button_tag type: :button, class: "btn btn-secondary", data: {action: "click->remote-modal#hide"} do
      = sprite_icon("times")
      = button_text(:cancel)
