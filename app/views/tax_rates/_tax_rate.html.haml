%tr
  %th{scope: "row"}
    = @pagination_metadata.offset + index
  %td
    = TranspoLink::CountryInfo.new(tax_rate.country).country_name
  %td
    = enum_l(tax_rate, :tax_identifier_type)
  %td
    = enum_l(tax_rate, :tax_type)
  %td
    = enum_l(tax_rate, :business_category)
  %td
    = number_to_percentage(tax_rate.rate, precision: 2)
  %td
    = tax_rate.valid_from.to_fs(:long)
  %td
    = tax_rate.valid_to&.to_fs(:long) || "-"
  %td
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      %li
        = link_to edit_tax_rate_path(tax_rate), class: "dropdown-item" do
          = sprite_icon("pencil")
          = button_text(:edit)
      %li
        = link_to tax_rate_path(tax_rate), class: "dropdown-item",
          data: {turbo_method: :delete, turbo_confirm: t(".delete_confirmation_text")} do
          = sprite_icon("trash")
          = button_text(:delete)
