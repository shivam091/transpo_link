= title(t(".title"))
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header.d-flex.align-items-center.justify-content-between
        .d-block
          .widget-title
            = t(".your_preferences")
          .widget-help
            = t(".edit_preferences")
        - if authorized_for?(:preferences, :update)
          = link_to edit_preference_path, class: "btn btn-secondary" do
            = sprite_icon("pencil")
            = button_text(:edit)
      .widget-body
        = safe_render.partial("preferences/show", user: @user)
