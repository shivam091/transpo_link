= title(t(".title"))
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header.d-flex.align-items-center.justify-content-between
        .d-block
          .widget-title
            = t(".your_preferences")
          .widget-help
            = t(".edit_preferences")
        = link_to edit_preference_path, class: "btn btn-secondary" do
          = external_svg_tag("svgs/pencil.svg")
          = button_text(:edit)
      .widget-body
        = render_if_exists("preferences/show", locals: {user: @user})
