  = help_text(t(".preferred_datetime_format_help_text"))
.col-sm-12.col-md-6.col-lg-4
  = form.label :preferred_color_scheme, class: "form-label required"
  .col
    - enum_options_for_select(User::Preference, :preferred_color_schemes).each do |label, color_scheme|
      .form-check.form-check-inline.mt-1
        = form.radio_button :preferred_color_scheme, color_scheme, id: "preferred_color_scheme_#{color_scheme}",
          checked: (form.object.preferred_color_scheme == color_scheme)
        = form.label :preferred_color_scheme, label, class: "form-check-label", for: "preferred_color_scheme_#{color_scheme}"
  = help_text(t(".preferred_color_scheme_help_text"))
.col-sm-12.col-md-6.col-lg-4
  = form.label :are_notifications_enabled, class: "form-check-label required mb-2"
  .form-switch.mt-1
    = form.check_box :are_notifications_enabled, checked: form.object.are_notifications_enabled?
  = help_text(t(".are_notifications_enabled_help_text"))
.col-sm-12.col-md-6.col-lg-4
  = form.label :enable_keyboard_shortcuts, class: "form-check-label required mb-2"
  .form-switch.mt-1
    = form.check_box :enable_keyboard_shortcuts, checked: form.object.enable_keyboard_shortcuts?
  = help_text(t(".enable_keyboard_shortcuts_help_text"))
.col-sm-12.col-md-6.col-lg-4
  = form.label :first_day_of_week, class: "form-label required"
  = form.select :first_day_of_week, options_for_select(enum_options_for_select(User::Preference, :first_day_of_weeks), form.object.first_day_of_week),
    {include_blank: t(".select_first_day_of_week")}
  = help_text(t(".first_day_of_week_help_text"))
