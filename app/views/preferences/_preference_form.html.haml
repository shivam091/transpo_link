.col-sm-12.col-md-6.col-lg-4
  = form.label :preferred_locale, class: "form-label required"
  = form.select :preferred_locale, options_for_select(TranspoLink::I18n.select_options, form.object.preferred_locale),
    {include_blank: t(".select_preferred_language")}
  = help_text(t(".preferred_locale_help_text"))
