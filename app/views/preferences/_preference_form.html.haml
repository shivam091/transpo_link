.col-sm-12.col-md-6.col-lg-4
  = form.label :preferred_datetime_format, class: "form-label required"
  = form.select :preferred_datetime_format, options_for_select(TranspoLink::DateTime.date_time_format_select_options, form.object.preferred_datetime_format),
