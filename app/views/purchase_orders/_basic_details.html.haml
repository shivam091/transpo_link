- warehouse, manager, supplier = purchase_order.key_associations
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:warehouse_id)
    .widget-row-body
      = link_to warehouse.name, warehouse_path(warehouse), target: :_blank
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:manager_id)
    .widget-row-body
      = link_to manager.full_name, user_path(manager), target: :_blank
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:supplier_id)
    .widget-row-body
      = link_to supplier.full_name, user_path(supplier), target: :_blank
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:reference_document)
    .widget-row-body
      = purchase_order.reference_document || "-"
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:order_date)
    .widget-row-body
      = purchase_order.order_date.to_date.to_fs(:long)
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:expected_delivery_date)
    .widget-row-body
      = purchase_order.expected_delivery_date&.to_fs(:long) || "-"
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:actual_delivery_date)
    .widget-row-body
      = purchase_order.actual_delivery_date&.to_fs(:long) || "-"
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:status)
    .widget-row-body
      = enum_l(purchase_order, :status)
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:notes)
    .widget-row-body
      = purchase_order.notes || "-"
