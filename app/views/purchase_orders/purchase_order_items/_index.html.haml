.table-responsive
  %table.table.table-striped
    %thead.border
      %tr.table-active
        %th{scope: "col", width: "25px"}#
        - PurchaseOrderItem::LISTING_ATTRIBUTES.each do |attribute|
          %th{scope: "col"}
            = PurchaseOrderItem.human_attribute_name(attribute)
    %tbody.border
      - if purchase_order.purchase_order_items&.each.with_index(1) do |purchase_order_item, index|
        = render_if_exists("purchase_orders/purchase_order_items/purchase_order_item", locals: {purchase_order_item:, index:})
      - end.empty?
        = render_if_exists("shared/no_records", locals: {resource: PurchaseOrderItem})
