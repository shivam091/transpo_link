- product = purchase_order_item.product
%tr
  %th{scope: "row"}
    = index
  %td
    = link_to product.name, product_path(product), target: :_blank
  %td
    = TranspoLink::MeasurementUnits.display_label(purchase_order_item.quantity, purchase_order_item.uom)
  %td
    = number_to_currency(purchase_order_item.unit_cost, unit: purchase_order_item.currency.symbol)
  %td
    = number_to_currency(purchase_order_item.total_cost, unit: purchase_order_item.currency.symbol)
  %td
    = enum_i18n(PurchaseOrderItem, :statuses, purchase_order_item.status)
