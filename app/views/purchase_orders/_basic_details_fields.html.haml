- if form.object.persisted?
  .col-sm-12.col-md-6.col-lg-3
    = form.label :reference_code, class: "form-label"
    = form.text_field :reference_code, static: true
.col-sm-12.col-md-6.col-lg-3
  = form.label :warehouse_id, class: "form-label required"
  = form.select :warehouse_id, options_for_select(current_user.managed_warehouses.select_options, form.object.warehouse_id),
    {include_blank: t(".select_warehouse")}, {}
.col-sm-12.col-md-6.col-lg-3
  = form.label :supplier_id, class: "form-label required"
  = form.select :supplier_id, options_for_select(User.suppliers.select_options, form.object.supplier_id),
    {include_blank: t(".select_supplier")}, {}
.col-12
  = form.label :notes, class: "form-label"
  = form.text_area :notes, rows: 5
