- warehouse, manager, supplier = @purchase_order.key_associations
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:warehouse_id)
    .widget-row-body
      = authorized_for?(:warehouses, :view) ? link_to_warehouse(warehouse, target: :_blank) : warehouse.name
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:manager_id)
    .widget-row-body
      = authorized_for?(:users, :view) ? link_to_user(manager, target: :_blank) : manager.full_name
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:supplier_id)
    .widget-row-body
      = authorized_for?(:users, :view) ? link_to_user(supplier, target: :_blank) : supplier.full_name
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:order_date)
    .widget-row-body
      = prettify_datetime(@purchase_order.order_date)
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:delivered_at)
    .widget-row-body
      = prettify_date(@purchase_order.delivered_at) || "-"
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:status)
    .widget-row-body
      = safe_render.partial("shared/badge", color: TranspoLink::ColorMapper.new(:status).for(@purchase_order.status)) do
        = enum_l(@purchase_order, :status)
.widget-row
  .widget-row-content
    .widget-row-title
      = PurchaseOrder.human_attribute_name(:notes)
    .widget-row-body
      = @purchase_order.notes || "-"
