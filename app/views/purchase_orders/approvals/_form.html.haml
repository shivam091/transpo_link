= pretty_form_with model: [@purchase_order, @approval], scope: :approval, class: "row g-2",
  url: purchase_order_approval_path(@purchase_order) do |form|
  %p
    = t(".approval_note", reference_code: @purchase_order.reference_code)
  .col-12
    = form.label :reference_document, class: "form-label required"
    = form.text_field :reference_document
  .col-12
    = form.label :expected_delivery_date, class: "form-label required"
    = form.date_field :expected_delivery_date
  .col-12
    = form.label :incoterm_code, class: "form-label required"
    = form.select :incoterm_code, options_for_select(enum_options_for_select(PurchaseOrder::Approval, :incoterm_codes), form.object.incoterm_code&.upcase),
      {include_blank: t(".select_incoterm_code")}, {}
  .col-12
    = form.label :shipping_method, class: "form-label required"
    = form.select :shipping_method, options_for_select(enum_options_for_select(PurchaseOrder::Approval, :shipping_methods), form.object.shipping_method&.upcase),
      {include_blank: t(".select_shipping_method")}, {}
  .col-12
    = form.label :payment_terms, class: "form-label required"
    = form.text_area :payment_terms, rows: 2
  .col-12
    = form.label :remarks, class: "form-label"
    = form.text_area :remarks, rows: 2
  .col-12
    .form-check
      = form.label :partial_delivery_allowed, class: "form-check-label"
      = form.check_box :partial_delivery_allowed
  .modal-actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = sprite_icon("check")
      = button_text(:confirm_approval)
    = button_tag type: :button, class: "btn btn-secondary", data: {action: "click->remote-modal#hide"} do
      = sprite_icon("times")
      = button_text(:cancel)
