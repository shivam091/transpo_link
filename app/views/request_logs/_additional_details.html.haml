.widget-row.d-flex
  .flex-auto
    .widget-row-title= RequestLog.human_attribute_name(:session_id)
    .widget-row-body= h(request_log.session_id)
.widget-row.d-flex
  .flex-auto
    .widget-row-title= RequestLog.human_attribute_name(:session_private_id)
    .widget-row-body= h(request_log.session_private_id)
.widget-row.d-flex
  .flex-auto
    .widget-row-title= RequestLog.human_attribute_name(:exception_message)
    .widget-row-body= h(request_log.exception_message)
.widget-row.d-flex
  .flex-auto
    .widget-row-title= RequestLog.human_attribute_name(:query_params)
    .widget-row-body.pretty-json= h(JSON.pretty_generate(JSON.parse(request_log.query_params.to_json)))
.widget-row.d-flex
  .flex-auto
    .widget-row-title= RequestLog.human_attribute_name(:ip_info)
    .widget-row-body.pretty-json= h(JSON.pretty_generate(JSON.parse(request_log.ip_info.to_json)))
