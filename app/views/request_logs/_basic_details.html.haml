.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:uri)
    .widget-row-body
      = link_to request_log.uri, request_log.uri, target: :_blank
.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:method)
    .widget-row-body
      = request_log.method
.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:query_params)
    .widget-row-body.pretty-json
      = JSON.pretty_generate(JSON.parse(request_log.query_params.to_json))
.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:session_id)
    .widget-row-body
      = request_log.session_id
.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:remote_address)
    .widget-row-body
      = IPAddr.new(request_log.remote_address, Socket::AF_INET) rescue ""
.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:user_agent)
    .widget-row-body
      = request_log.user_agent
.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:referrer)
    .widget-row-body
      = link_to request_log.referrer, request_log.referrer, target: :_blank
.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:origin)
    .widget-row-body
      = link_to request_log.origin, request_log.origin, target: :_blank
.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:status)
    .widget-row-body
      = request_log.status
.widget-row
  .widget-row-content
    .widget-row-title
      = RequestLog.human_attribute_name(:elapsed_time)
    .widget-row-body
      = prettify_seconds(request_log.elapsed_time)
