= title(t(".title"))
.card.card-primary.border.border-primary
  .card-body
    .table-responsive
      %table.table.table-striped.table-borderless
        %thead.border
          %tr.table-active
            %th{width: "3%", scope: "col"}#
            - RequestLog::LISTING_ATTRIBUTES.each do |attribute|
              %th{scope: "col"}
                = RequestLog.human_attribute_name(attribute)
            %th{width: "3%", scope: "col"}
              = t("shared.actions")
        %tbody.border
          - if @request_logs&.each.with_index(1) do |request_log, index|
            = safe_render.partial("request_logs/request_log", request_log:, index:)
          - end.empty?
            = safe_render.partial("shared/no_records", resource: RequestLog)
  - if @pagination_metadata.needs_pagination?
    .card-footer
      = render_pagination(@pagination_metadata)
