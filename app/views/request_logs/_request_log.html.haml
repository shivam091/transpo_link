- accessed_by = request_log.user
%tr
  %th{scope: "row"}= @pagination_metadata.offset + index
  %td= link_to request_log.uuid, request_log_path(request_log)
  %td= link_to request_log.uri, request_log.uri, target: :_blank
  %td= request_log.method
  %td= IPAddr.new(request_log.remote_address, Socket::AF_INET) rescue ""
  %td= prettify_seconds(request_log.elapsed_time)
  %td= request_log.status
  %td= number_to_human_size(request_log.response_size)
  %td= time_ago_with_tooltip(request_log.created_at)
  %td
    - if accessed_by.present?
      = link_to accessed_by&.full_name, user_path(accessed_by), target: :_blank
  %td
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = external_svg_tag("svgs/ellipsis-vertical.svg")
    %ul.dropdown-menu
      %li
        = link_to request_log_path(request_log), class: "dropdown-item" do
          = external_svg_tag("svgs/arrow-right.svg")
          = button_text(:view_details)
