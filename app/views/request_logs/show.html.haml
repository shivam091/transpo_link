= title(@request_log.id)
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header
        .widget-title
          = h(@request_log.uuid)
        .widget-help
          = h(RequestLog.human_attribute_name(:created_at))
          = h(time_ago_with_tooltip(@request_log.created_at))
      .widget-body
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:uri)
            .widget-row-body= @request_log.uri
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:method)
            .widget-row-body= h(@request_log.method)
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:session_id)
            .widget-row-body= h(@request_log.session_id)
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:session_private_id)
            .widget-row-body= h(@request_log.session_private_id)
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:remote_address)
            .widget-row-body= h(IPAddr.new(@request_log.remote_ip_address, Socket::AF_INET)) rescue ""
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:elapsed_time)
            .widget-row-body= h(prettify_seconds(@request_log.elapsed_time))
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:user_agent)
            .widget-row-body= h(@request_log.user_agent)
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:referrer)
            .widget-row-body= link_to @request_log.referrer, @request_log.referrer, target: :_blank
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:exception_message)
            .widget-row-body= @request_log.exception_message
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:status)
            .widget-row-body= @request_log.status
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:response_size)
            .widget-row-body= h(number_to_human_size(@request_log.response_size))
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:query_params)
            .widget-row-body.pretty-json= h(JSON.pretty_generate(JSON.parse(@request_log.query_params.to_json)))
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:ip_info)
            .widget-row-body.pretty-json= h(JSON.pretty_generate(JSON.parse(@request_log.ip_info.to_json)))
        .widget-row.d-flex
          .flex-auto
            .widget-row-title= RequestLog.human_attribute_name(:user_id)
            .widget-row-body= h(@request_log.user&.full_name)
