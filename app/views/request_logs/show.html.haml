= title(@request_log.uuid)
- accessed_by = @request_log.user
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header
        .widget-title
          = @request_log.uuid
        .widget-help
          %span.middle-dot-divider
            = RequestLog.human_attribute_name(:created_at)
            = time_ago_with_tooltip(@request_log.created_at)
          - if accessed_by.present?
            %span.middle-dot-divider
              = RequestLog.human_attribute_name(:user_id)
              = link_to accessed_by&.full_name, user_path(accessed_by), target: :_blank
    .widget
      .widget-header
        .widget-title
          = t(".basic_details")
      .widget-body
        = render_if_exists("request_logs/basic_details", locals: {request_log: @request_log})
    .widget
      .widget-header
        .widget-title
          = t(".advanced_details")
      .widget-body
        = render_if_exists("request_logs/advanced_details", locals: {request_log: @request_log})
