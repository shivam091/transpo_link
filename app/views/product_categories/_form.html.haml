= pretty_form_with model: @product_category, class: "row g-2" do |form|
  .col-12
    = form.label :name, class: "form-label required"
    = form.text_field :name, autofocus: true
  .col-12.mb-2
    = form.label :parent_category_id, class: "form-label"
    = form.select :parent_category_id, options_for_select(ProductCategory.select_options, form.object.parent_category_id),
      {include_blank: t(".select_parent_category")}, {}
  .col-12
    .form-check
      = form.label :is_active, class: "form-check-label"
      = form.check_box :is_active
  .modal-actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = external_svg_tag("svgs/floppy.svg")
      = form.object.new_record? ? button_text(:create) : button_text(:update)
    = button_tag type: :button, class: "btn btn-secondary", data: {action: "click->remote-modal#hide"} do
      = external_svg_tag("svgs/cancel.svg")
      = button_text(:cancel)
