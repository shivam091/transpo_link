.table-row
  .table-cell.cell-narrow
    = @pagination_metadata.offset + index
  .table-cell
    = product_category.name
  .table-cell
    = product_category.parent_category_name
  .table-cell
    = product_category.products_count
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = external_svg_tag("svgs/ellipsis-vertical.svg")
    %ul.dropdown-menu
      %li
        = link_to edit_product_category_path(product_category), class: "dropdown-item", data: {turbo_frame: :remote_modal} do
          = external_svg_tag("svgs/pencil.svg")
          = button_text(:edit)
      %li
        = link_to product_category_path(product_category), class: "dropdown-item",
          data: {turbo_confirm: t(".delete_confirmation_text", name: product_category.name), turbo_method: :delete} do
          = external_svg_tag("svgs/trash.svg")
          = button_text(:delete)
