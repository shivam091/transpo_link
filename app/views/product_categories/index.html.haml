= title(t(".title"))
.card.card-primary.border.border-primary
  .card-header
    .d-flex.justify-content-between.align-items-center
      = safe_render.partial("product_categories/nav_tabs")
      - if authorized_for?(:product_categories, :create)
        = link_to new_product_category_path, class: "btn btn-primary", data: {turbo_frame: :remote_modal} do
          = sprite_icon("plus")
          = button_text(:new)
  .card-body
    .table-wrapper
      .table-container
        .table-header
          .table-cell.cell-narrow #
          - ProductCategory::LISTING_ATTRIBUTES.each do |attribute|
            .table-cell
              = ProductCategory.human_attribute_name(attribute)
          .table-cell.cell-narrow
            = t("shared.actions")
        .table-body
          - if @product_categories&.each.with_index(1) do |product_category, index|
            = safe_render.partial("product_categories/product_category", product_category:, index:)
          - end.empty?
            = safe_render.partial("shared/no_records", resource: ProductCategory)
  - if @pagination_metadata.needs_pagination?
    .card-footer
      = render_pagination(@pagination_metadata)
