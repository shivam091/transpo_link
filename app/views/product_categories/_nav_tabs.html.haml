= safe_render.partial("shared/inline_navigations") do
  %ul.nav.nav-pills.flex-row
    %li.nav-item
      = link_to t(".all"), product_categories_path, class: class_names("nav-link", "active": params[:status].nil?)
    %li.nav-item
      = link_to t(".active"), active_product_categories_path, class: class_names("nav-link", "active": params[:status].eql?("active"))
    %li.nav-item
      = link_to t(".inactive"), inactive_product_categories_path, class: class_names("nav-link", "active": params[:status].eql?("inactive"))
