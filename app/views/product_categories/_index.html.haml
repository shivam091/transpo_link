.card.card-primary.border.border-primary
  .card-header
    .d-flex.justify-content-between.align-items-center
      = render_if_exists("product_categories/nav_tabs")
      = link_to "javascript:void(0)", class: "btn btn-primary" do
        = external_svg_tag("svgs/plus.svg")
        = button_text(:new)
  .card-body
    .table-responsive
      %table.table.table-striped.table-borderless
        %thead.border
          %tr.table-active
            %th{width: "25px", scope: "col"}#
            - ProductCategory::LISTING_ATTRIBUTES.each do |attribute|
              %th{scope: "col"}= ProductCategory.human_attribute_name(attribute)
            %th{scope: "col"}= t("common.actions")
        %tbody.border
          - if @product_categories&.each.with_index(1) do |product_category, index|
            = render_if_exists("product_categories/product_category", locals: {product_category:, index:})
          - end.empty?
            = render_if_exists("shared/no_records", locals: {resource: ProductCategory})
  - if @pagination_metadata.needs_pagination?
    .card-footer
      = render_pagination(@pagination_metadata)
