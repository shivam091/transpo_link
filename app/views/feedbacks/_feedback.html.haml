- user, reviewable = feedback.key_associations
.table-row
  .table-cell.cell-narrow
    = index
    - if feedback.is_unread? && params[:status].nil?
      .list-item-unread-indicator
  .table-cell
    = link_to feedback.reference_code, feedback_path(feedback)
  .table-cell
    = link_to_user(user, target: :_blank)
  .table-cell
    = link_to reviewable_name_with_type(reviewable), reviewable_link(reviewable), target: :_blank
  .table-cell
    = feedback.rating
  .table-cell{data: {controller: "collapsible-content", collapsible_content_show_more_text_value: t("shared.show_more"), collapsible_content_show_less_text_value: t("shared.show_less")}}
    %span{data: {collapsible_content_target: "collapsedContent"}}
      = truncate(feedback.comment, truncate_at: 80)
    - if feedback.comment.length > 80
      = link_to t("shared.show_more"), "javascript:void(0)", data: {action: "click->collapsible-content#toggle"}
    %template{data: {collapsible_content_target: "expandedContent"}}
      = word_wrap(feedback.comment, wrap_length: 120)
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      %li
        = link_to feedback_path(feedback), class: "dropdown-item" do
          = sprite_icon("arrow-right")
          = button_text(:view_details)
      - if feedback.is_unread?
        %li
          = link_to mark_as_read_feedback_path(feedback), class: "dropdown-item",
            data: {turbo_method: :patch, turbo_confirm: t(".mark_as_read_confirmation_text", reference_code: feedback.reference_code)} do
            = sprite_icon("check-circle")
            = button_text(:mark_as_read)
