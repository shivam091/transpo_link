= render_if_exists("shared/inline_navigations") do
  %ul.nav.nav-pills.flex-row
    %li.nav-item
      = link_to t(".all"), feedbacks_path, class: class_names("nav-link", "active": current_action?(:index))
    %li.nav-item
      = link_to t(".unread"), "javascript:void(0)", class: class_names("nav-link", "active": current_action?(:unread))
    %li.nav-item
      = link_to t(".read"), "javascript:void(0)", class: class_names("nav-link", "active": current_action?(:read))
