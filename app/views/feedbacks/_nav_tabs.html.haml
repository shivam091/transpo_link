= safe_render.partial("shared/inline_navigations") do
  %ul.nav.nav-pills.flex-row
    %li.nav-item
      = link_to t(".all"), feedbacks_path, class: class_names("nav-link", "active": params[:status].nil?)
    %li.nav-item
      = link_to t(".unread"), unread_feedbacks_path, class: class_names("nav-link", "active": params[:status].eql?("unread"))
    %li.nav-item
      = link_to t(".read"), read_feedbacks_path, class: class_names("nav-link", "active": params[:status].eql?("read"))
