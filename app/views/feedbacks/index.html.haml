= title(t(".title"))
.card.card-primary.border.border-primary
  .card-header
    = safe_render.partial("feedbacks/nav_tabs")
  .card-body
    .table-wrapper
      .table-container{data: {controller: "column-width-sync"}}
        .table-header
          .table-cell.cell-narrow #
          - Feedback::LISTING_ATTRIBUTES.each do |attribute|
            .table-cell
              = Feedback.human_attribute_name(attribute)
          .table-cell.cell-narrow
            = t("shared.actions")
        .table-body
          - if @feedbacks&.each.with_index(1) do |feedback, index|
            = safe_render.partial("feedbacks/feedback", feedback:, index:)
          - end.empty?
            = safe_render.partial("shared/no_records", resource: Feedback)
  - if @pagination_metadata.needs_pagination?
    .card-footer
      = render_pagination(@pagination_metadata)
