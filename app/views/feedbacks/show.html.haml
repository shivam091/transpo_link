= title(@feedback.reference_code)
- user, reviewable = @feedback.key_associations
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header.d-flex.align-items-center.justify-content-between
        .d-block
          .widget-title
            = @feedback.reference_code
          .widget-help
            = Feedback.human_attribute_name(:created_at)
            = time_ago_with_tooltip(@feedback.created_at)
        - if @feedback.is_unread?
          = link_to mark_as_read_feedback_path(@feedback), class: "btn btn-secondary",
            data: {turbo_method: :patch, turbo_confirm: t(".mark_as_read_confirmation_text", reference_code: @feedback.reference_code)} do
            = sprite_icon("check-circle")
            = button_text(:mark_as_read)
      .widget-body
        .widget-row
          .widget-row-content
            .widget-row-title
              = Feedback.human_attribute_name(:reviewable)
            .widget-row-body
              = link_to reviewable_name_with_type(reviewable), reviewable_link(reviewable), target: :_blank
        .widget-row
          .widget-row-content
            .widget-row-title
              = Feedback.human_attribute_name(:user_id)
            .widget-row-body
              = link_to user.full_name, user_path(user), target: :_blank
        .widget-row
          .widget-row-content
            .widget-row-title
              = Feedback.human_attribute_name(:rating)
            .widget-row-body
              = @feedback.rating
        .widget-row
          .widget-row-content
            .widget-row-title
              = Feedback.human_attribute_name(:comment)
            .widget-row-body
              = @feedback.comment
  .card-footer
    = render_if_exists("shared/navigable_links", locals: {record: @feedback})
