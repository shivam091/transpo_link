.card.card-primary.border.border-primary
  .card-header
    = render_if_exists("feedbacks/nav_tabs")
  .card-body
    .table-responsive
      %table.table.table-striped.table-borderless
        %thead.border
          %tr.table-active
            %th{width: "3%", scope: "col"}#
            - Feedback::LISTING_ATTRIBUTES.each do |attribute|
              %th{scope: "col"}
                = Feedback.human_attribute_name(attribute)
            %th{width: "3%", scope: "col"}
              = t("shared.actions")
        %tbody.border
          - if @feedbacks&.each.with_index(1) do |feedback, index|
            = render_if_exists("feedbacks/feedback", locals: {feedback:, index:})
          - end.empty?
            = render_if_exists("shared/no_records", locals: {resource: Feedback})
  - if @pagination_metadata.needs_pagination?
    .card-footer
      = render_pagination(@pagination_metadata)
