.table-wrapper
  .table-container
    .table-header
      .table-cell.cell-narrow #
      - Inventory::Movement::LISTING_ATTRIBUTES.each do |attribute|
        .table-cell
          = Inventory::Movement.human_attribute_name(attribute)
    .table-body
      - if @inventory_movements&.each.with_index(1) do |inventory_movement, index|
        = safe_render.partial("inventory_movements/inventory_movement", inventory_movement:, index:)
      - end.empty?
        = safe_render.partial("shared/no_records", resource: Inventory::Movement)
