.table-row
  .table-cell.cell-narrow
    = index
  .table-cell
    = prettify_datetime(inventory_movement.movement_date)
  .table-cell
    = enum_l(inventory_movement, :movement_type)
  .table-cell
    = number_to_measurement_unit(inventory_movement.quantity, inventory_movement.unit_symbol)
  .table-cell
    = number_to_currency(inventory_movement.unit_cost, unit: @inventory.currency.symbol)
  .table-cell
    = number_to_currency(inventory_movement.total_cost, unit: @inventory.currency.symbol)
