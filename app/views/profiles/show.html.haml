= title(t(".title"))
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header.d-flex.align-items-center.justify-content-between
        .d-block
          .widget-title
            = t(".your_profile")
          .widget-help
            = t(".edit_profile_details")
        = link_to edit_profile_path, class: "btn btn-secondary" do
          = external_svg_tag("svgs/pencil.svg")
          = button_text(:edit)
      .widget-body
        .widget-row
          .widget-row-content
            .widget-row-title
              = UserDetail.human_attribute_name(:full_name)
            .widget-row-body
              = h(@user.full_name)
        .widget-row
          .widget-row-content
            .widget-row-title
              = User.human_attribute_name(:email)
            .widget-row-body
              = h(@user.email)
        .widget-row
          .widget-row-content
            .widget-row-title
              = User.human_attribute_name(:password)
            .widget-row-body
              ******
        .widget-row
          .widget-row-content
            .widget-row-title
              = UserDetail.human_attribute_name(:mobile_number)
            .widget-row-body
              = h(@user.mobile_number)
            .widget-help
              = t(".mobile_number_help_text")
        .widget-row
          .widget-row-content
            .widget-row-title
              = UserDetail.human_attribute_name(:alternate_contact_number)
            .widget-row-body
              = h(@user.alternate_contact_number)
        .widget-row
          .widget-row-content
            .widget-row-title
              = UserDetail.human_attribute_name(:alternate_email)
            .widget-row-body
              = h(@user.alternate_email)
        .widget-row
          .widget-row-content
            .widget-row-title
              = t(".address")
            .widget-row-body
              = h(@user.address.humanize)
