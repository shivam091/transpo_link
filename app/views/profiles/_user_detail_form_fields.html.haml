.row
  .col-sm-12.col-md-6.col-lg-4.mb-3
    = form.label :first_name, class: "form-label required"
    = form.text_field :first_name, autofocus: true
  .col-sm-12.col-md-6.col-lg-4.mb-3
    = form.label :last_name, class: "form-label required"
    = form.text_field :last_name
  .col-sm-12.col-md-6.col-lg-4.mb-3
    = form.label :mobile_number, class: "form-label"
    = form.text_field :mobile_number
  .col-sm-12.col-md-6.col-lg-4.mb-3
    = form.label :alternate_contact_number, class: "form-label"
    = form.text_field :alternate_contact_number
  .col-sm-12.col-md-6.col-lg-4.mb-3
    = form.label :alternate_email, class: "form-label"
    = form.text_field :alternate_email
