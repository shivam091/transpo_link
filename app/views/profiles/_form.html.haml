= pretty_form_with model: @user, url: profile_path, class: "row g-3",
  data: {controller: "country-select", country_select_url_value: states_url} do |form|
  = form_errors(@user)
  .subheader
    = t(".profile_details")
  = form.fields_for :user_detail, include_id: false do |user_detail_form|
    = safe_render.partial("profiles/user_detail_form_fields", form: user_detail_form)
  .subheader
    = t(".address")
  = form.fields_for :address, include_id: false do |address_form|
    = safe_render.partial("shared/address_form_fields", form: address_form)
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = external_svg_tag("svgs/floppy.svg")
      = button_text(:update)
    = link_to profile_path, class: "btn btn-secondary" do
      = external_svg_tag("svgs/times.svg")
      = button_text(:cancel)
