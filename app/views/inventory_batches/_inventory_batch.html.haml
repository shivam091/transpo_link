.table-row
  .table-cell.cell-narrow
    = index
  .table-cell
    = inventory_batch.batch_number
  .table-cell
    = prettify_date(inventory_batch.expiration_date) || "-"
  .table-cell
    = number_to_measurement_unit(inventory_batch.quantity, inventory_batch.unit_symbol)
  .table-cell
    = number_to_currency(inventory_batch.cost_price, unit: inventory_batch.currency.symbol)
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      %li
        = link_to "javascript:void(0)", class: "dropdown-item" do
          = sprite_icon("arrow-right")
          = button_text(:view_details)
