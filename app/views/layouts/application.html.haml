!!!5
%html{dir: t("direction"), lang: TranspoLink::I18n.locale}
  %head
    %title
      = h(content_for?(:title) ? yield(:title) : t(".title"))
    %meta{"http-equiv": "Content-Type", content: "text/html; charset=UTF-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1, shrink-to-fit=no"}
    %meta{name: "version", content: "1.0"}
    %meta{name: "author", content: "Harshal Ladhe"}
    %meta{name: "turbo-cache-control", content: "no-cache"}
    %meta{name: "turbo-prefetch", content: "false"}
    = favicon_link_tag
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag :app, media: "all", data: {turbo_track: "reload"}
    = yield(:stylesheet) if content_for?(:stylesheet)
    = javascript_importmap_tags
    = yield(:javascript) if content_for?(:javascript)
  %body{data: {bs_theme: current_user.preferred_color_scheme}}
    = render_if_exists("layouts/application/main_navigation")
    = render_if_exists("layouts/application/secondary_navigation")
    .clearfix
    %main.container-fluid.my-2
      = turbo_frame_tag :flash_messages_frame do
        = render_if_exists("shared/flash_messages")
      = yield
    .clearfix
    = render_if_exists("layouts/application/footer")
    = turbo_frame_tag :remote_modal, target: :_top
