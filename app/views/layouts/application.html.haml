= safe_render.partial("layouts/shared_layout") do
  %body{data: {bs_theme: current_user.preferred_color_scheme}}
    = safe_render.partial("layouts/application/main_navigation")
    = safe_render.partial("layouts/application/secondary_navigation")
    .clearfix
    %main.container-fluid.my-2
      = turbo_frame_tag :flash_messages_frame do
        = safe_render.partial("shared/flash_messages")
      = render_breadcrumbs
      = yield
    .clearfix
    = safe_render.partial("layouts/application/footer")
    = turbo_frame_tag :remote_modal, target: :_top
