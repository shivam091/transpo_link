= render_if_exists("layouts/application/top_menu") do
  %nav.navbar.navbar-expand-lg.divider.bg-body{aria: {label: t(".main_navigation")}}
    .container-fluid
      = link_to root_path, class: "navbar-brand" do
        = external_svg_tag("logo.svg", height: "36px", width: "36px")
      .d-flex.ms-auto
        = button_tag type: :button, class: "navbar-toggler collapsed", data: {bs_toggle: "collapse", bs_target: "#navbar"},
          aria: {controls: "navbar-default", expanded: false, label: t(".toggle_navigation")} do
          %span.icon-bar.top-bar.mt-0
          %span.icon-bar.middle-bar
          %span.icon-bar.bottom-bar
      #navbar.navbar-collapse.collapse.divider
        %ul.navbar-nav.me-auto
          %li.nav-item
            = link_to root_path, class: class_names("nav-link", "active": current_controller?(:dashboards)) do
              = sprite_icon("dashboard")
              = t(".dashboard")
          %li.nav-item
            = link_to users_path, class: class_names("nav-link", "active": current_controller?(:users)) do
              = sprite_icon("users")
              = t(".users")
          %li.nav-item
            = link_to request_logs_path, class: class_names("nav-link", "active": current_controller?(:request_logs)) do
              = sprite_icon("logs")
              = t(".request_logs")
        %ul.navbar-nav.d-none.d-lg-flex.ms-2
          = render_if_exists("layouts/application/menu")
        %ul.navbar-nav.d-lg-none
          %li.nav-item-divider
          = render_if_exists("layouts/application/menu")
