%li.nav-item.dropdown
  = link_to "javascript:void(0)", class: "nav-link dropdown-toggle", aria: {expanded: false}, data: {bs_toggle: "dropdown"} do
    = t(".hello_username", username: current_user.full_name)
  %ul.dropdown-menu.dropdown-menu-lg-end
    %li
      %h6.dropdown-header.fw-bold= t(".your_account")
    %li
      = link_to profile_path, class: "dropdown-item" do
        = sprite_icon("personalize")
        = t(".your_profile")
    %li
      = link_to preference_path, class: "dropdown-item" do
        = sprite_icon("cog")
        = t(".your_preferences")
    %li
      = link_to legal_identifiers_path, class: "dropdown-item" do
        = sprite_icon("check-alt")
        = t(".your_legal_identifiers")
    - if current_user.enable_keyboard_shortcuts
      %li.dropdown-divider
      %li
        = link_to "javascript:void(0)", class: "dropdown-item" do
          = sprite_icon("keyboard")
          = t(".keyboard_shortcuts")
    %li.dropdown-divider
    %li
      = link_to destroy_user_session_path, class: "dropdown-item", data: {turbo_method: :delete} do
        = sprite_icon("sign-out")
        = t(".sign_out")
