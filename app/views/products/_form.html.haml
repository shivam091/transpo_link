= pretty_form_with model: @product, class: "row g-3" do |form|
  .subheader
    = t(".basic_details")
  = safe_render.partial("products/basic_details_fields", form:)
  .subheader
    = t(".product_prices")
  = safe_render.partial("product_prices/form/tabular_view", form:)
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = sprite_icon("floppy")
      = form.object.new_record? ? button_text(:create) : button_text(:update)
    = link_to products_path, class: "btn btn-secondary" do
      = sprite_icon("times")
      = button_text(:cancel)
