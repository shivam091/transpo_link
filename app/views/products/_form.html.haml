= pretty_form_with model: @product, class: "row g-3" do |form|
  .subheader
    = t(".basic_details")
  = safe_render.partial("products/basic_details_fields", form:)
  .subheader
    = t(".unit_conversions")
  = safe_render.partial("products/unit_conversions/form", form:)
  .subheader
    = t(".product_prices")
  = safe_render.partial("products/product_prices/form", form:)
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = external_svg_tag("svgs/floppy.svg")
      = form.object.new_record? ? button_text(:create) : button_text(:update)
    = link_to products_path, class: "btn btn-secondary" do
      = external_svg_tag("svgs/times.svg")
      = button_text(:cancel)
