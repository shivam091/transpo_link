= pretty_form_with model: @product do |form|
  = render_if_exists("products/basic_details_fields", locals: {form: form})
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = external_svg_tag("svgs/floppy.svg")
      = @product.new_record? ? button_text(:create) : button_text(:update)
    = link_to products_path, class: "btn btn-secondary" do
      = external_svg_tag("svgs/cancel.svg")
      = button_text(:cancel)
