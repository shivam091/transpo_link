= pretty_form_with model: @product, class: "row g-3" do |form|
  .subheader
    = t(".basic_details")
  = render_if_exists("products/basic_details_fields", locals: {form:})
  .subheader
    = t(".unit_conversions")
  = render_if_exists("products/unit_conversions/form", locals: {form:})
  .subheader
    = t(".product_prices")
  = render_if_exists("products/product_prices/form", locals: {form:})
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = sprite_icon("floppy")
      = form.object.new_record? ? button_text(:create) : button_text(:update)
    = link_to products_path, class: "btn btn-secondary" do
      = sprite_icon("times")
      = button_text(:cancel)
