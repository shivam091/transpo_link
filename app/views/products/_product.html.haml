%tr
  %th{scope: "row"}
    = @pagination_metadata.offset + index
  %td
    = check_box_tag "product_ids[]", product.id, false, class: "form-check-input", data: {checkbox_selection_target: "itemCheckbox"}
  %td
    = link_to product.reference_code, product_path(product)
  %td
    = h(product.name)
  %td
    = h(product.sku)
  %td
    = h(product.barcode)
  %td
    = number_to_currency(product.cost_price, unit: product.currency.symbol)
  %td
    = h(product.product_category_name)
  %td
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = external_svg_tag("svgs/ellipsis-vertical.svg")
    %ul.dropdown-menu
      %li
        = link_to new_product_feedback_path(product), class: "dropdown-item", data: {turbo_frame: :remote_modal} do
          = external_svg_tag("svgs/speech-bubble.svg")
          = button_text(:leave_feedback)
      %li.dropdown-divider
      %li
        = link_to product_path(product), class: "dropdown-item" do
          = external_svg_tag("svgs/arrow-right.svg")
          = button_text(:view_details)
      %li
        = link_to edit_product_path(product), class: "dropdown-item" do
          = external_svg_tag("svgs/pencil.svg")
          = button_text(:edit)
      %li
        = link_to product_path(product), class: "dropdown-item",
          data: {turbo_confirm: t(".delete_product_confirmation_text", product_name: product.name), turbo_method: :delete} do
          = external_svg_tag("svgs/trash.svg")
          = button_text(:delete)
