= title(t(".title"))
.card.card-primary.border.border-primary
  .card-header
    .d-flex.justify-content-between.align-items-center
      = safe_render.partial("products/nav_tabs")
      - if authorized_for?(:products, :create)
        = link_to new_product_path, class: "btn btn-primary" do
          = sprite_icon("plus")
          = button_text(:new)
  .card-body{data: {controller: "checkbox-selection"}}
    %p.mb-2{data: {checkbox_selection_target: "selectedCount", label_template: t("shared.selected", count: "%{count}")}}
    .table-wrapper
      .table-container
        .table-header
          .table-cell.cell-narrow #
          - if @products.size > 0
            .table-cell.cell-narrow
              = check_box_tag "checkbox", nil, false, class: "form-check-input", data: {checkbox_selection_target: "selectAll"}
          - Product::LISTING_ATTRIBUTES.each do |attribute|
            .table-cell
              = Product.human_attribute_name(attribute)
          .table-cell.cell-narrow
            = t("shared.actions")
        .table-body
          - if @products&.each.with_index(1) do |product, index|
            = safe_render.partial("products/product", product:, index:)
          - end.empty?
            = safe_render.partial("shared/no_records", resource: Product)
  - if @pagination_metadata.needs_pagination?
    .card-footer
      = render_pagination(@pagination_metadata)
