.card.card-primary.border.border-primary
  .card-header
    .d-flex.justify-content-between.align-items-center
      = render_if_exists("products/nav_tabs")
  .card-body{data: {controller: "checkbox-selection"}}
    %p.mb-2{data: {checkbox_selection_target: "selectedCount", label_template: t("common.selected", count: "%{count}")}}
    .table-responsive
      %table.table.table-striped.table-borderless
        %thead.border
          %tr.table-active
            %th{width: "25px", scope: "col"}#
            - if @products.size > 0
              %th{width: "25px", scope: "col"}
                = check_box_tag "checkbox", nil, false, class: "form-check-input", data: {checkbox_selection_target: "selectAll"}
            - Product::LISTING_ATTRIBUTES.each do |attribute|
              %th{scope: "col"}= Product.human_attribute_name(attribute)
            %th{scope: "col"}= t("common.actions")
        %tbody.border
          - if @products&.each.with_index(1) do |product, index|
            = render_if_exists("products/product", locals: {product:, index:})
          - end.empty?
            = render_if_exists("shared/no_records", locals: {resource: Product})
  - if @pagination_metadata.needs_pagination?
    .card-footer
      = render_pagination(@pagination_metadata)
