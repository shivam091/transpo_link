.mb-3{data: {controller: "nested-forms", nested_forms_wrapper_selector_value: ".product-price-form-wrapper"}}
  .col-12.text-end.mb-lg-10.mb-2
    = button_tag type: :button, class: "btn btn-secondary", data: {action: "click->nested-forms#addAssociation"} do
      = external_svg_tag("svgs/plus.svg")
      = button_text(:add)
  .table-responsive
    %table.table.table-striped
      %thead.border
        %tr.table-active
          %th{scope: "col"} #
          %th{scope: "col"}= ProductPrice.human_attribute_name(:warehouse_id)
          %th{scope: "col"}= ProductPrice.human_attribute_name(:min_quantity)
          %th{scope: "col"}= ProductPrice.human_attribute_name(:unit_price)
          %th{scope: "col"}= ProductPrice.human_attribute_name(:currency)
          %th{scope: "col"}= t("shared.actions")
      %tbody.border
        %template{data: {nested_forms_target: "template"}}
          = form.fields_for :product_prices, form.object.product_prices.build, child_index: "NEW_RECORD" do |product_price_form|
            = render_if_exists("products/product_prices/field", locals: {form: product_price_form})
        = form.fields_for :product_prices do |product_price_form|
          = render_if_exists("products/product_prices/field", locals: {form: product_price_form})
        %tr{data: {nested_forms_target: "target"}}
