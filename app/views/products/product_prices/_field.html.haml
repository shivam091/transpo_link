%tr.product-price-form-wrapper{data: {new_record: form.object.new_record?}}
  %td
    = (form.index + 1) if form.object.persisted?
    = form.hidden_field :id, value: form.object.id
    = form.hidden_field :_destroy
  %td
    = form.select :warehouse_id, options_for_select(Warehouse.select_options, form.object.warehouse_id),
      {include_blank: t(".select_warehouse")}, {}
  %td
    = form.number_field :min_quantity, step: 1
  %td
    = form.number_field :unit_price, step: 0.01
  %td
    = form.select :currency, options_for_select(TranspoLink::Currency.options_for_currencies, form.object.currency),
      {include_blank: t(".select_currency")}
  %td
    = button_tag type: :button, class: "btn btn-sm btn-danger", data: {action: "click->nested-forms#removeAssociation"} do
      = external_svg_tag("svgs/trash.svg")
