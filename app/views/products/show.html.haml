= title(@product.reference_code)
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header.d-flex.align-items-center.justify-content-between
        .d-block
          .widget-title
            = @product.reference_code
          .widget-help
            %span.middle-dot-divider
              = Product.human_attribute_name(:created_at)
              = time_ago_with_tooltip(@product.created_at)
            %span.middle-dot-divider
              = Product.human_attribute_name(:updated_at)
              = time_ago_with_tooltip(@product.updated_at)
        = link_to edit_product_path(@product), class: "btn btn-secondary" do
          = external_svg_tag("svgs/pencil.svg")
          = button_text(:edit)
    .widget
      .widget-header
        .widget-title
          = t(".basic_details")
      .widget-body
        = safe_render.partial("products/basic_details", product: @product)
    .widget
      .widget-header
        .widget-title
          = t(".unit_conversions")
      .widget-body
        = safe_render.partial("products/unit_conversions/index", product: @product)
    .widget
      .widget-header
        .widget-title
          = t(".product_prices")
      .widget-body
        = safe_render.partial("products/product_prices/index", product: @product)
  .card-footer
    = safe_render.partial("shared/navigable_links", resource: @product)
