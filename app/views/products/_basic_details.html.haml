.widget-row
  .widget-row-content
    .widget-row-title
      = Product.human_attribute_name(:name)
    .widget-row-body
      = product.name
.widget-row
  .widget-row-content
    .widget-row-title
      = Product.human_attribute_name(:product_category_id)
    .widget-row-body
      = product.product_category_name
.widget-row
  .widget-row-content
    .widget-row-title
      = Product.human_attribute_name(:sku)
    .widget-row-body
      = product.sku
.widget-row
  .widget-row-content
    .widget-row-title
      = Product.human_attribute_name(:barcode)
    .widget-row-body
      = product.barcode || "-"
.widget-row
  .widget-row-content
    .widget-row-title
      = Product.human_attribute_name(:description)
    .widget-row-body
      = product.description
.widget-row
  .widget-row-content
    .widget-row-title
      = Product.human_attribute_name(:cost_price)
    .widget-row-body
      = number_to_currency(product.cost_price, unit: product.currency.symbol)
.widget-row
  .widget-row-content
    .widget-row-title
      = Product.human_attribute_name(:min_stock_threshold)
    .widget-row-body
      = number_to_measurement_unit(product.min_stock_threshold, product.unit_symbol)
