= pretty_form_with model: @warehouse, class: "row g-3",
  data: {controller: "country-select", country_select_url_value: states_url} do |form|
  = form_errors(@warehouse)
  .subheader
    = t(".basic_details")
  = safe_render.partial("warehouses/basic_details_fields", form: form)
  .subheader
    = t(".address")
  = form.fields_for :address, include_id: false do |address_form|
    = safe_render.partial("shared/address_form_fields", form: address_form)
  .actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = external_svg_tag("svgs/floppy.svg")
      = form.object.new_record? ? button_text(:create) : button_text(:update)
    = link_to warehouses_path, class: "btn btn-secondary" do
      = external_svg_tag("svgs/times.svg")
      = button_text(:cancel)
