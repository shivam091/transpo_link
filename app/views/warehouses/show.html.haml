- present(@warehouse) do |warehouse|
  = title(warehouse.reference_code)
  .card.card-primary.border.border-primary
    .card-body
      .widget
        .widget-header.d-flex.align-items-center.justify-content-between
          .d-block
            .widget-title
              = h(warehouse.reference_code)
            .widget-help
              %span.middle-dot-divider
                = Warehouse.human_attribute_name(:created_at)
                = h(time_ago_with_tooltip(warehouse.created_at))
              %span.middle-dot-divider
                = Warehouse.human_attribute_name(:updated_at)
                = h(time_ago_with_tooltip(warehouse.updated_at))
          = link_to edit_warehouse_path(warehouse), class: "btn btn-secondary" do
            = external_svg_tag("svgs/pencil.svg")
            = button_text("edit")
        .widget-body
          .widget-row.d-flex
            .flex-auto
              .widget-row-title= Warehouse.human_attribute_name(:name)
              .widget-row-body= h(warehouse.name)
          .widget-row.d-flex
            .flex-auto
              .widget-row-title= Warehouse.human_attribute_name(:email_address)
              .widget-row-body= mail_to warehouse.email_address
          .widget-row.d-flex
            .flex-auto
              .widget-row-title= Warehouse.human_attribute_name(:contact_number)
              .widget-row-body= h(warehouse.contact_number)
          .widget-row.d-flex
            .flex-auto
              .widget-row-title= Warehouse.human_attribute_name(:description)
              .widget-row-body= h(warehouse.description)
          .widget-row.d-flex
            .flex-auto
              .widget-row-title= Warehouse.human_attribute_name(:capacity)
              .widget-row-body= h(warehouse.capacity)
          .widget-row.d-flex
            .flex-auto
              .widget-row-title= Warehouse.human_attribute_name(:latitude)
              .widget-row-body= h(warehouse.formatted_latitude)
          .widget-row.d-flex
            .flex-auto
              .widget-row-title= Warehouse.human_attribute_name(:longitude)
              .widget-row-body= h(warehouse.formatted_longitude)
