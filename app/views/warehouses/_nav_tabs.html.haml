= render_if_exists("shared/inline_navigations") do
  %ul.nav.nav-pills.flex-row
    %li.nav-item
      = link_to t(".all"), warehouses_path, class: class_names("nav-link", "active": current_action?(:index))
    %li.nav-item
      = link_to t(".active"), active_warehouses_path, class: class_names("nav-link", "active": current_action?(:active))
    %li.nav-item
      = link_to t(".inactive"), inactive_warehouses_path, class: class_names("nav-link", "active": current_action?(:inactive))
