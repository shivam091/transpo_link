- if form.object.persisted?
  .col-sm-12.col-md-6.col-lg-4
    = form.label :reference_code, class: "form-label"
    = form.text_field :reference_code, static: true
.col-sm-12.col-md-6.col-lg-4
  = form.label :name, class: "form-label required"
  = form.text_field :name, autofocus: true
.col-sm-12.col-md-6.col-lg-4
  = form.label :email_address, class: "form-label"
  = form.text_field :email_address
.col-sm-12.col-md-6.col-lg-4
  = form.label :contact_number, class: "form-label"
  = form.text_field :contact_number
.col-12
  = form.label :description, class: "form-label"
  = form.text_area :description, rows: 5
.col-sm-12.col-md-6.col-lg-4
  = form.label :total_capacity, class: "form-label required"
  = form.number_field :total_capacity, step: 0.0001
.col-sm-12.col-md-6.col-lg-4
  = form.label :unit_id, class: "form-label required"
  = form.measurement_unit_select :unit_id, {include_blank: t(".select_capacity_unit")}, {}
.col-sm-12.col-md-6.col-lg-4
  = form.label :latitude, class: "form-label"
  = form.number_field :latitude, step: 0.0000000000001
.col-sm-12.col-md-6.col-lg-4
  = form.label :longitude, class: "form-label"
  = form.number_field :longitude, step: 0.000000000001
.col-sm-12.col-md-6.col-lg-4
  = form.label :manager_ids, class: "form-label required"
  = form.select :manager_ids, options_for_select(User.managers.select_options, form.object.manager_ids),
    {include_blank: t(".select_managers"), multiple: true}, {}
.col-sm-12.col-md-6.col-lg-4
  = form.label :supplier_ids, class: "form-label required"
  = form.select :supplier_ids, options_for_select(User.suppliers.select_options, form.object.supplier_ids),
    {include_blank: t(".select_suppliers"), multiple: true}, {}
.col-12
  = form.label :is_active, class: "form-check-label mb-2"
  .form-check
    = form.check_box :is_active
