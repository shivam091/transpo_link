.table-row
  .table-cell.cell-narrow
    = @pagination_metadata.offset + index
  .table-cell.cell-narrow
    = check_box_tag "warehouse_ids[]", warehouse.id, false, id: dom_id(warehouse), class: "form-check-input",
      data: {checkbox_selection_target: "itemCheckbox"}
  .table-cell
    = conditional_link_to authorized_for?(:warehouses, :view), warehouse_path(warehouse) do
      = warehouse.reference_code
  .table-cell
    = warehouse.name
  .table-cell
    = warehouse.email_address.present? ? mail_to(warehouse.email_address) : "-"
  .table-cell
    = warehouse.contact_number || "-"
  .table-cell
    = number_to_measurement_unit(warehouse.total_capacity, warehouse.unit_symbol)
  .table-cell
    = number_to_angle(warehouse.latitude) || "-"
  .table-cell
    = number_to_angle(warehouse.longitude) || "-"
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      - if authorized_for?(:warehouses, :view)
        %li
          = link_to warehouse_path(warehouse), class: "dropdown-item" do
            = sprite_icon("arrow-right")
            = button_text(:view_details)
      - if authorized_for?(:warehouses, :update)
        %li
          = link_to edit_warehouse_path(warehouse), class: "dropdown-item" do
            = sprite_icon("pencil")
            = button_text(:edit)
      - if authorized_for?(:warehouses, :delete)
        %li
          = link_to warehouse_path(warehouse), class: "dropdown-item",
            data: {turbo_confirm: t(".delete_confirmation_text", name: warehouse.name), turbo_method: :delete} do
            = sprite_icon("trash")
            = button_text(:delete)
