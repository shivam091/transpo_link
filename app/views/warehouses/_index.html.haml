.card.card-primary.border.border-primary
  .card-header
    .d-flex.justify-content-between.align-items-center
      = render_if_exists("warehouses/nav_tabs")
      = link_to new_warehouse_path, class: "btn btn-primary" do
        = external_svg_tag("svgs/plus.svg")
        = button_text(:new)
  .card-body{data: {controller: "checkbox-selection"}}
    .mb-2{data: {checkbox_selection_target: "selectedCount", label_template: t("shared.selected", count: "%{count}")}}
    .table-responsive
      %table.table.table-striped.table-borderless
        %thead.border
          %tr.table-active
            %th{width: "25px", scope: "col"}#
            - if @warehouses.size > 0
              %th{width: "25px", scope: "col"}
                = check_box_tag "checkbox", nil, false, class: "form-check-input", data: {checkbox_selection_target: "selectAll"}
            - Warehouse::LISTING_ATTRIBUTES.each do |attribute|
              %th{scope: "col"}= Warehouse.human_attribute_name(attribute)
            %th{scope: "col"}= t("shared.actions")
        %tbody.border
          - if @warehouses&.each.with_index(1) do |warehouse, index|
            = render_if_exists("warehouses/warehouse", locals: {warehouse:, index:})
          - end.empty?
            = render_if_exists("shared/no_records", locals: {resource: Warehouse})
  - if @pagination_metadata.needs_pagination?
    .card-footer
      = render_pagination(@pagination_metadata)
