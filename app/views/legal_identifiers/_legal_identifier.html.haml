%tr
  %th{scope: "row"}= h(@pagination_metadata.offset + index)
  %td= h(TranspoLink::CountryInfo.new(legal_identifier.country).country_name)
  %td= h(enum_i18n(LegalIdentifier, :entity_types, legal_identifier.entity_type))
  %td= h(enum_i18n(LegalIdentifier, :tax_identifier_types, legal_identifier.tax_identifier_type))
  %td= h(legal_identifier.tax_identifier)
  %td
    - if legal_identifier.business_identifier_type.present?
      = h(enum_i18n(LegalIdentifier, :business_identifier_types, legal_identifier.business_identifier_type))
  %td= h(legal_identifier.business_identifier)
  %td.actions
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = external_svg_tag("svgs/ellipsis-vertical.svg")
    %ul.dropdown-menu
      %li
        = link_to edit_legal_identifier_path(legal_identifier), class: "dropdown-item", data: {turbo_frame: :remote_modal} do
          = external_svg_tag("svgs/pencil.svg")
          = button_text(:edit)
      %li
        = link_to legal_identifier_path(legal_identifier), class: "dropdown-item",
          data: {turbo_method: :delete, turbo_confirm: t(".delete_legal_identifier_confirmation_text")} do
          = external_svg_tag("svgs/trash.svg")
          = button_text(:delete)
