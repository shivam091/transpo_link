.table-row
  .table-cell.cell-narrow
    = @pagination_metadata.offset + index
  .table-cell
    = TranspoLink::CountryInfo.new(legal_identifier.country).country_name
  .table-cell
    = enum_l(legal_identifier, :entity_type)
  .table-cell
    = enum_l(legal_identifier, :tax_identifier_type)
  .table-cell
    = legal_identifier.tax_identifier
  .table-cell
    = enum_l(legal_identifier, :business_identifier_type) || "-"
  .table-cell
    = legal_identifier.business_identifier || "-"
  .table-cell
    = safe_render.partial("shared/badge", color: TranspoLink::ColorMapper.new(:status).for(legal_identifier.status)) do
      = enum_l(legal_identifier, :status)
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      - if legal_identifier.unapproved?
        %li
          = link_to approve_legal_identifier_path(legal_identifier), class: "dropdown-item",
            data: {turbo_method: :patch, turbo_confirm: t(".approve_confirmation_text")} do
            = sprite_icon("check")
            = button_text(:approve)
        %li
          = link_to reject_legal_identifier_path(legal_identifier), class: "dropdown-item",
            data: {turbo_method: :patch, turbo_confirm: t(".reject_confirmation_text")} do
            = sprite_icon("times")
            = button_text(:reject)
        %li.dropdown-divider
      %li
        = link_to edit_legal_identifier_path(legal_identifier), class: "dropdown-item", data: {turbo_frame: :remote_modal} do
          = sprite_icon("pencil")
          = button_text(:edit)
      %li
        = link_to legal_identifier_path(legal_identifier), class: "dropdown-item",
          data: {turbo_method: :delete, turbo_confirm: t(".delete_confirmation_text")} do
          = sprite_icon("trash")
          = button_text(:delete)
