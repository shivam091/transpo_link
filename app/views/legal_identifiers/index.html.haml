= title(t(".title"))
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header.d-flex.align-items-center.justify-content-between
        .d-block
          .widget-title
            = t(".your_legal_identifiers")
          .widget-help
            = t(".your_legal_identifiers_help_text")
        = link_to new_legal_identifier_path, class: "btn btn-primary", data: {turbo_frame: :remote_modal} do
          = external_svg_tag("svgs/plus.svg")
          = button_text(:new)
      .widget-body
        = render_if_exists("legal_identifiers/help_texts")
        .table-responsive
          %table.table.table-striped.table-borderless
            %thead.border
              %tr.table-active
                %th{width: "3%", scope: "col"}#
                - LegalIdentifier::LISTING_ATTRIBUTES.each do |attribute|
                  %th{scope: "col"}
                    = LegalIdentifier.human_attribute_name(attribute)
                %th{width: "3%", scope: "col"}
                  = t("shared.actions")
            %tbody.border
              - if @legal_identifiers&.each.with_index(1) do |legal_identifier, index|
                = render_if_exists("legal_identifiers/legal_identifier", locals: {legal_identifier:, index:})
              - end.empty?
                = render_if_exists("shared/no_records", locals: {resource: LegalIdentifier})
      - if @pagination_metadata.total_pages > 1
        .widget-footer
          = render_pagination(@pagination_metadata)
