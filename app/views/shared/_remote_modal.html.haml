= turbo_frame_tag :remote_modal do
  .modal.fade{id: modal_id, tabindex: "-1", role: "dialog", aria: {labelledby: "#{modal_id}-label", hidden: false}, data: {controller: "remote-modal", action: "turbo:before-render@document->remote-modal#hideBeforeRender"}}
    .modal-dialog{class: "#{size_class} modal-dialog-centered modal-dialog-scrollable"}
      .modal-content
        .modal-header
          %h5.modal-title{id: "#{modal_id}-label"}
            = title
          %button.btn-close{type: "button", data: {bs_dismiss: "modal"}, aria: {label: t(".close")}}
        .modal-body
          = yield
