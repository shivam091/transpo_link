.col-sm-12.col-md-6.col-lg-6
  = form.label :address1, class: "form-label required"
  = form.text_field :address1
.col-sm-12.col-md-6.col-lg-6
  = form.label :address2, class: "form-label"
  = form.text_field :address2
.col-sm-12.col-md-6.col-lg-4
  = form.label :country, class: "form-label required"
  = form.select :country, options_for_select(TranspoLink::CountryInfo.select_options, form.object.country),
    {include_blank: t(".select_country")}
.col-sm-12.col-md-6.col-lg-4
  = form.label :state, class: "form-label"
  = form.select :state, options_for_select(TranspoLink::CountryInfo.new(form.object.country).select_subdivision_options, form.object.state),
    {include_blank: t(".select_state")}
.col-sm-12.col-md-6.col-lg-4
  = form.label :city, class: "form-label"
  = form.text_field :city
.col-sm-12.col-md-6.col-lg-4
  = form.label :postal_code, class: "form-label"
  = form.text_field :postal_code
