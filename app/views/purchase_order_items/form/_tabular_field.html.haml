.table-row.purchase-order-item-form-wrapper{data: {new_record: form.object.new_record?}}
  = form.hidden_field :id, value: form.object.id
  = form.hidden_field :_destroy
  .table-cell.cell-narrow
    = (form.index + 1) if form.object.persisted?
  .table-cell.flex-column
    = form.select :product_id, options_for_select(Product.select_options, form.object.product_id),
      {include_blank: t(".select_product")}, {}
  .table-cell.flex-column
    = form.number_field :quantity, step: 0.01
  .table-cell.flex-column
    = form.measurement_unit_select :unit_id, {include_blank: t(".select_unit_of_measure")}, {}
  .table-cell.cell-narrow
    = button_tag type: :button, class: "btn btn-sm btn-danger", data: {action: "click->nested-forms#removeAssociation"} do
      = sprite_icon("trash")
