= pretty_form_with model: [@purchase_order, @purchase_order_item], class: "row g-2" do |form|
  .col-12
    = form.label :product_id, class: "form-label required"
    = form.select :product_id, options_for_select(Product.select_options, form.object.product_id),
      {include_blank: t(".select_product")}, {}
  .col-12
    = form.label :quantity, class: "form-label required"
    = form.number_field :quantity, step: 0.01
  .col-12
    = form.label :unit_id, class: "form-label required"
    = form.measurement_unit_select :unit_id, {include_blank: t(".select_unit_of_measure")}, {}
  .modal-actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = sprite_icon("floppy")
      = form.object.new_record? ? button_text(:create) : button_text(:update)
    = button_tag type: :button, class: "btn btn-secondary", data: {action: "click->remote-modal#hide"} do
      = sprite_icon("times")
      = button_text(:cancel)
