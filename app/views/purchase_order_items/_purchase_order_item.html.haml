- product = purchase_order_item.product
.table-row
  .table-cell.cell-narrow
    = index
  .table-cell
    = link_to product.name, product_path(product), target: :_blank
  .table-cell
    = number_to_measurement_unit(purchase_order_item.quantity, purchase_order_item.unit_symbol)
  .table-cell
    = number_to_measurement_unit(purchase_order_item.remaining_quantity, purchase_order_item.unit_symbol)
  .table-cell
    = number_to_currency(purchase_order_item.unit_cost, unit: purchase_order_item.currency.symbol)
  .table-cell
    = number_to_currency(purchase_order_item.total_cost, unit: purchase_order_item.currency.symbol)
  .table-cell
    = safe_render.partial("shared/badge", color: TranspoLink::ColorMapper.new(:status).for(purchase_order_item.status)) do
      = enum_l(purchase_order_item, :status)
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      %li
        = link_to purchase_order_purchase_order_item_path(@purchase_order, purchase_order_item), class: "dropdown-item",
          data: {turbo_frame: :remote_modal} do
          = sprite_icon("arrow-right")
          = button_text(:view_details)
      - if @purchase_order.draft? || @purchase_order.submitted?
        %li
          = link_to edit_purchase_order_purchase_order_item_path(@purchase_order, purchase_order_item), class: "dropdown-item",
            data: {turbo_frame: :remote_modal} do
            = sprite_icon("pencil")
            = button_text(:edit)
        %li
          = link_to purchase_order_purchase_order_item_path(@purchase_order, purchase_order_item), class: "dropdown-item",
            data: {turbo_confirm: t(".delete_confirmation_text", product: product.name), turbo_method: :delete} do
            = sprite_icon("trash")
            = button_text(:delete)
        - if purchase_order_item.may_cancel?
          %li
            = link_to cancel_purchase_order_purchase_order_item_path(@purchase_order, purchase_order_item), class: "dropdown-item",
              data: {turbo_confirm: t(".cancel_confirmation_text", product: product.name), turbo_method: :patch} do
              = sprite_icon("times")
              = button_text(:cancel)
      - if (@purchase_order.approved? || @purchase_order.partially_delivered?) && purchase_order_item.may_deliver?
        %li
          = link_to new_purchase_order_purchase_order_item_delivery_path(@purchase_order, purchase_order_item), class: "dropdown-item",
            data: {turbo_frame: :remote_modal} do
            = sprite_icon("check")
            = button_text(:deliver)
