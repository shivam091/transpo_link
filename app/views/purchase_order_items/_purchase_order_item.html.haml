- product = purchase_order_item.product
.table-row
  .table-cell.cell-narrow
    = index
  .table-cell
    = authorized_for?(:products, :view) ? link_to_product(product, target: :_blank) : product.name
  .table-cell
    = number_to_measurement_unit(purchase_order_item.quantity, purchase_order_item.unit_symbol)
  .table-cell
    = number_to_measurement_unit(purchase_order_item.remaining_quantity, purchase_order_item.unit_symbol)
  .table-cell
    = number_to_currency(purchase_order_item.unit_cost, unit: purchase_order_item.currency.symbol)
  .table-cell
    = number_to_currency(purchase_order_item.total_cost, unit: purchase_order_item.currency.symbol)
  .table-cell
    = safe_render.partial("shared/badge", color: TranspoLink::ColorMapper.new(:status).for(purchase_order_item.status)) do
      = enum_l(purchase_order_item, :status)
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      - if authorized_for?(:inventory_batches, :create) && purchase_order_item.available_batch_quantity > 0.0
        %li
          = link_to new_purchase_order_item_inventory_batch_path(purchase_order_item), class: "dropdown-item",
            data: {turbo_frame: :remote_modal} do
            = sprite_icon("plus")
            = button_text(:create_batch)
        %li.dropdown-divider
      - if authorized_for?(:purchase_order_items, :view)
        %li
          = link_to purchase_order_item_path(purchase_order_item), class: "dropdown-item",
            data: {turbo_frame: :remote_modal} do
            = sprite_icon("arrow-right")
            = button_text(:view_details)
      - if authorized_for?(:purchase_order_items, :update) && (@purchase_order.draft? || @purchase_order.submitted?)
        %li
          = link_to edit_purchase_order_item_path(purchase_order_item), class: "dropdown-item",
            data: {turbo_frame: :remote_modal} do
            = sprite_icon("pencil")
            = button_text(:edit)
        - if authorized_for?(:purchase_order_items, :delete)
          %li
            = link_to purchase_order_item_path(purchase_order_item), class: "dropdown-item",
              data: {turbo_confirm: t(".delete_confirmation_text", product: product.name), turbo_method: :delete, turbo_frame: :_top} do
              = sprite_icon("trash")
              = button_text(:delete)
      - if authorized_for?(:purchase_order_items, :deliver) && (@purchase_order.approved? || @purchase_order.partially_delivered?) && purchase_order_item.may_deliver?
        %li
          = link_to new_purchase_order_item_delivery_path(purchase_order_item), class: "dropdown-item",
            data: {turbo_frame: :remote_modal} do
            = sprite_icon("check")
            = button_text(:deliver)
