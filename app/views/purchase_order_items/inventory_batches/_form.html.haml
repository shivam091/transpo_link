= pretty_form_with model: [@purchase_order_item, @inventory_batch], class: "row g-2" do |form|
  .col-md-12.col-lg-6
    = form.label :batch_number, class: "form-label required"
    = form.text_field :batch_number
  .col-md-12.col-lg-6
    = form.label :expiration_date, class: "form-label required"
    = form.date_field :expiration_date
  .col-md-12.col-lg-6
    = form.label :quantity, class: "form-label required"
    = form.number_field :quantity, step: 0.01
  .col-md-12.col-lg-6
    = form.label :unit_id, class: "form-label required"
    = form.measurement_unit_select :unit_id, category: @purchase_order_item.unit.category,
      include_blank: t(".select_unit")
  .modal-actions
    = button_tag type: :submit, class: "btn btn-primary" do
      = sprite_icon("floppy")
      = form.object.new_record? ? button_text(:create) : button_text(:update)
    = button_tag type: :button, class: "btn btn-secondary", data: {action: "click->remote-modal#hide"} do
      = sprite_icon("times")
      = button_text(:cancel)
