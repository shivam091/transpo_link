.table-wrapper
  .table-container
    .table-header
      .table-cell.cell-narrow #
      - Product::Price::LISTING_ATTRIBUTES.each do |attribute|
        .table-cell
          = Product::Price.human_attribute_name(attribute)
    .table-body
      - if @product.prices&.each.with_index(1) do |product_price, index|
        = safe_render.partial("product_prices/product_price", product_price:, index:)
      - end.empty?
        = safe_render.partial("shared/no_records", resource: Product::Price)
