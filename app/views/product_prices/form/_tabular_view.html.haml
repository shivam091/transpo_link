%div{data: {controller: "nested-forms", nested_forms_wrapper_selector_value: ".product-price-form-wrapper"}}
  .col-12.text-end.mb-2
    = button_tag type: :button, class: "btn btn-secondary", data: {action: "click->nested-forms#addAssociation"} do
      = sprite_icon("plus")
      = button_text(:add)
  .table-responsive
    .table-container
      .table-header
        .table-cell.cell-narrow #
        .table-cell
          = ProductPrice.human_attribute_name(:warehouse_id)
        .table-cell
          = ProductPrice.human_attribute_name(:min_quantity)
        .table-cell
          = ProductPrice.human_attribute_name(:unit_price)
        .table-cell
          = ProductPrice.human_attribute_name(:currency)
        .table-cell.cell-narrow
          = t("shared.actions")
      .table-body
        %template{data: {nested_forms_target: "template"}}
          = form.fields_for :product_prices, form.object.product_prices.build, child_index: "NEW_RECORD" do |product_price_form|
            = safe_render.partial("product_prices/form/tabular_field", form: product_price_form)
        = form.fields_for :product_prices do |product_price_form|
          = safe_render.partial("product_prices/form/tabular_field", form: product_price_form)
        .table-row.d-none{data: {nested_forms_target: "target"}}
