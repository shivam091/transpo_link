= safe_render.partial("shared/inline_navigations") do
  %ul.nav.nav-pills.flex-row
    - if authorized_for?(:users, :view_all)
      %li.nav-item
        = link_to t(".all"), users_path, class: class_names("nav-link", "active": params[:status].nil?)
    - if authorized_for?(:users, :view_active)
      %li.nav-item
        = link_to t(".active"), active_users_path, class: class_names("nav-link", "active": params[:status].eql?("active"))
    - if authorized_for?(:users, :view_inactive)
      %li.nav-item
        = link_to t(".inactive"), inactive_users_path, class: class_names("nav-link", "active": params[:status].eql?("inactive"))
    - if authorized_for?(:users, :view_suspended)
      %li.nav-item
        = link_to t(".suspended"), suspended_users_path, class: class_names("nav-link", "active": params[:status].eql?("suspended"))
