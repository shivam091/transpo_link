= title(t(".title"))
.card.card-primary.border.border-primary
  .card-header
    = safe_render.partial("users/nav_tabs")
  .card-body{data: {controller: "checkbox-selection"}}
    .mb-2{data: {checkbox_selection_target: "selectedCount", label_template: t("shared.selected", count: "%{count}")}}
    .table-wrapper
      .table-container
        .table-header
          .table-cell.cell-narrow #
          - if @users.size > 0
            .table-cell.cell-narrow
              = check_box_tag "checkbox", nil, false, class: "form-check-input", data: {checkbox_selection_target: "selectAll"}
          .table-cell
            = UserDetail.human_attribute_name(:full_name)
          .table-cell
            = User.human_attribute_name(:email)
          .table-cell
            = UserDetail.human_attribute_name(:mobile_number)
          .table-cell
            = UserDetail.human_attribute_name(:alternate_contact_number)
          .table-cell
            = UserDetail.human_attribute_name(:alternate_email)
          .table-cell
            = User.human_attribute_name(:role_id)
          .table-cell.cell-narrow
            = t("shared.actions")
        .table-body
          - if @users&.each.with_index(1) do |user, index|
            = safe_render.partial("users/user", user:, index:)
          - end.empty?
            = safe_render.partial("shared/no_records", resource: User)
  - if @pagination_metadata.needs_pagination?
    .card-footer
      = render_pagination(@pagination_metadata)
