.widget-row
  .widget-row-content
    .widget-row-title
      = User.human_attribute_name(:role_id)
    .widget-row-body
      = user.role_name.humanize
.widget-row
  .widget-row-content
    .widget-row-title
      = User.human_attribute_name(:email)
    .widget-row-body
      = mail_to user.email
.widget-row
  .widget-row-content
    .widget-row-title
      = User::Detail.human_attribute_name(:mobile_number)
    .widget-row-body
      = user.mobile_number || "-"
.widget-row
  .widget-row-content
    .widget-row-title
      = User::Detail.human_attribute_name(:alternate_contact_number)
    .widget-row-body
      = user.alternate_contact_number || "-"
.widget-row
  .widget-row-content
    .widget-row-title
      = User::Detail.human_attribute_name(:alternate_email)
    .widget-row-body
      = user.alternate_email.present? ? mail_to(user.alternate_email) : "-"
.widget-row
  .widget-row-content
    .widget-row-title
      = User.human_attribute_name(:address)
    .widget-row-body
      = user.address.persisted? ? user.address.humanize : "-"
