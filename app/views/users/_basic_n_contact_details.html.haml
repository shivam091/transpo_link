  .flex-auto
    .widget-row-title= UserDetail.human_attribute_name(:alternate_contact_number)
    .widget-row-body= h(user.alternate_contact_number)
.widget-row.d-flex
  .flex-auto
    .widget-row-title= UserDetail.human_attribute_name(:alternate_email)
    .widget-row-body= mail_to user.alternate_email
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:address)
    .widget-row-body= h(user.address.humanize)
