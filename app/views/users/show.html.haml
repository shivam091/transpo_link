= title(@user.full_name)
.card.card-primary.border.border-primary
  .card-body
    .widget
      .widget-header
        .widget-title
          = @user.full_name
        .widget-help
          %span.middle-dot-divider
            = User.human_attribute_name(:created_at)
            = time_ago_with_tooltip(@user.created_at)
          %span.middle-dot-divider
            = User.human_attribute_name(:updated_at)
            = time_ago_with_tooltip(@user.updated_at)
    .widget
      .widget-header
        .widget-title
          = t(".basic_n_contact_details")
      .widget-body
        = safe_render.partial("users/basic_n_contact_details", user: @user)
    .widget
      .widget-header
        .widget-title
          = t(".additional_details")
      .widget-body
        = safe_render.partial("users/additional_details", user: @user)
  .card-footer
    = safe_render.partial("shared/navigable_links", resource: @user)
