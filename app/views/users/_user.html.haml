.table-row
  .table-cell.cell-narrow
    = index
  .table-cell.cell-narrow
    = check_box_tag "user_ids[]", user.id, false, id: dom_id(user), class: "form-check-input",
      data: {checkbox_selection_target: "itemCheckbox"}
  .table-cell
    = authorized_for?(:users, :view) ? link_to_user(user) : user.full_name
  .table-cell
    = mail_to user.email
  .table-cell
    = user.mobile_number || "-"
  .table-cell
    = user.alternate_contact_number || "-"
  .table-cell
    = user.alternate_email.present? ? mail_to(user.alternate_email) : "-"
  .table-cell
    = user.role_name.humanize
  .table-cell.cell-narrow
    = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
      = sprite_icon("ellipsis-vertical")
    %ul.dropdown-menu
      - if authorized_for?(:users, :view)
        %li
          = link_to user_path(user), class: "dropdown-item" do
            = sprite_icon("arrow-right")
            = button_text(:view_details)
      - if authorized_for?(:users, :update)
        %li
          = link_to "javascript:void(0)", class: "dropdown-item" do
            = sprite_icon("pencil")
            = button_text(:edit)
      - if authorized_for?(:users, :delete)
        %li
          = link_to "javascript:void(0)", class: "dropdown-item" do
            = sprite_icon("trash")
            = button_text(:delete)
