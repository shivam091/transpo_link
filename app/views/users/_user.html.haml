.mb-2{data: {checkbox_selection_target: "selectedCount", label_template: t("common.selected", count: "%{count}")}}
.table-responsive
  %table.table.table-striped.table-borderless
    %thead.border
      %tr.table-active
        %th{width: "25px", scope: "col"}#
        - if @users.size > 0
          %th{width: "25px", scope: "col"}
            = check_box_tag "checkbox", nil, false, class: "form-check-input", data: {checkbox_selection_target: "selectAll"}
        %th{scope: "col"}= UserDetail.human_attribute_name(:full_name)
        %th{scope: "col"}= User.human_attribute_name(:email)
        %th{scope: "col"}= UserDetail.human_attribute_name(:mobile_number)
        %th{scope: "col"}= UserDetail.human_attribute_name(:alternate_contact_number)
        %th{scope: "col"}= UserDetail.human_attribute_name(:alternate_email)
        %th{scope: "col"}= User.human_attribute_name(:role_id)
        %th{width: "25px", scope: "col"}= t(".actions")
    %tbody.border
      - if @users&.each.with_index(1) do |user, index|
        %tr
          %th{scope: "row"}= @pagination_metadata.offset + index
          %td
            = check_box_tag "user_ids[]", user.id, false, class: "form-check-input", data: {checkbox_selection_target: "itemCheckbox"}
          %td= link_to user.full_name, user_path(user)
          %td= mail_to user.email
          %td= user.mobile_number
          %td= user.alternate_contact_number
          %td= mail_to user.alternate_email
          %td= user.role_name.humanize
          %td.actions
            .dropdown
              = link_to "javascript:void(0)", class: "text-reset", data: {bs_toggle: "dropdown"}, aria: {expanded: false} do
                = external_svg_tag("svgs/ellipsis-vertical.svg")
              %ul.dropdown-menu
                %li
                  = link_to "javascript:void(0)", class: "dropdown-item" do
                    = external_svg_tag("svgs/pencil.svg")
                    = button_text(:edit)
                %li
                  = link_to "javascript:void(0)", class: "dropdown-item" do
                    = external_svg_tag("svgs/trash.svg")
                    = button_text(:delete)
      - end.empty?
        %tr
          %td.no-data{colspan: User.columns.count}
            = t(".no_users_to_display")
