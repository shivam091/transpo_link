.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:last_activity_at)
    .widget-row-body= h(time_ago_with_tooltip(user.last_activity_at))
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:sign_in_count)
    .widget-row-body= h(user.sign_in_count)
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:current_sign_in_at)
    .widget-row-body= h(time_ago_with_tooltip(user.current_sign_in_at))
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:last_sign_in_at)
    .widget-row-body= h(time_ago_with_tooltip(user.last_sign_in_at))
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:current_sign_in_ip)
    .widget-row-body= h(IPAddr.new(user.current_sign_in_ip, Socket::AF_INET)) rescue ""
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:last_sign_in_ip)
    .widget-row-body= h(IPAddr.new(user.last_sign_in_ip, Socket::AF_INET)) rescue ""
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:confirmed_at)
    .widget-row-body= h(time_ago_with_tooltip(user.confirmed_at))
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:confirmation_sent_at)
    .widget-row-body= h(time_ago_with_tooltip(user.confirmation_sent_at))
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:unconfirmed_email)
    .widget-row-body= mail_to user.unconfirmed_email
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:failed_attempts)
    .widget-row-body= h(user.failed_attempts)
.widget-row.d-flex
  .flex-auto
    .widget-row-title= User.human_attribute_name(:locked_at)
    .widget-row-body= h(time_ago_with_tooltip(user.locked_at))
