= title(t(".title"))
.text-center
  %h4.fw-bold.mb-3.fw-normal= t(".password_assistance")
  %p=t (".password_reset_note")
= form_with model: resource, as: resource_name, url: password_path(resource_name), data: {turbo: false} do |form|
  = form_errors(resource)
  .col-12
    .form-floating.mb-3
      = form.text_field :email, autofocus: true, autocomplete: "new-email", class: "form-control",
        placeholder: User.human_attribute_name(:email), value: (params[:email] || resource.email)
      = form.label :email, class: "form-label required"
  .col-12
    = form.button type: :submit, class: "w-100 btn btn-primary justify-content-center" do
      = button_text(:continue)
      = external_svg_tag("svgs/arrow-right.svg")
